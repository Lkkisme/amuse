# Copy to .env (gitignored) and fill in. Nothing is required: without a model key, remuse runs a
# scripted demo. The access token is made on first start (see the README).

# Models, as provider/model-id: the chat agent, and (optionally) the browser agent
REMUSE_PI_MODEL=openrouter/z-ai/glm-5.3-flash
# REMUSE_PI_BROWSER_MODEL=anthropic/claude-sonnet-5-5

# API keys for the providers your models use, under their standard names (any provider Pi knows)
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=

# Optional: a Composio API key (ak_…), to connect apps such as Gmail or Google Sheets
REMUSE_COMPOSIO_KEY=

# Optional: where your browser reaches this instance, if not http://localhost:8080
# (connectors send you back here after you authorize an app)
# REMUSE_PUBLIC_URL=https://muse.your-tailnet.ts.net
# REMUSE_PUBLISH_PORT=8080

# Optional: your own access token instead of the one made on first start
# REMUSE_TOKEN=
