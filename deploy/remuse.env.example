# Copy to deploy/remuse.env (gitignored) and fill in.
# Access token: anyone with it can use this instance. openssl rand -hex 24
REMUSE_TOKEN=
# Model for the chat and browser agents, as provider/model-id
REMUSE_PI_MODEL=openrouter/z-ai/glm-5.3-flash
# This instance's address as your browser reaches it (e.g. https://muse.your-tailnet.ts.net):
# connectors send you back here after authorizing, so a connection shows up at once.
REMUSE_PUBLIC_URL=
